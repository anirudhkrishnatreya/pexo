# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://pexo:pexo_dev_password@localhost:5432/pexo?schema=public

# --- Redis (cache, leaderboards, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- OAuth providers (fill in real credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pexo-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Push notifications ---
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=

# --- Maps ---
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
